<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Version>0.2.1</Version>
    <AssemblyName>AgentMonRelay</AssemblyName>
    <RootNamespace>AgentMon.Relay.Windows</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\AgentMonRelay.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <InternalsVisibleTo Include="AgentMon.Relay.Windows.Tests" />
    <EmbeddedResource Include="Assets\AgentMonRelay.Stopped.ico"
                      LogicalName="AgentMon.Relay.Windows.Assets.AgentMonRelay.Stopped.ico" />
    <EmbeddedResource Include="Assets\AgentMonRelay.Running.ico"
                      LogicalName="AgentMon.Relay.Windows.Assets.AgentMonRelay.Running.ico" />
    <EmbeddedResource Include="Assets\AgentMonRelay.Waiting.ico"
                      LogicalName="AgentMon.Relay.Windows.Assets.AgentMonRelay.Waiting.ico" />
    <EmbeddedResource Include="Assets\AgentMonRelay.Error.ico"
                      LogicalName="AgentMon.Relay.Windows.Assets.AgentMonRelay.Error.ico" />
  </ItemGroup>
  <Target Name="CopyRuntimeNotices" AfterTargets="Publish">
    <Copy SourceFiles="%(ResolvedRuntimePack.PackageDirectory)\THIRD-PARTY-NOTICES.TXT"
          DestinationFiles="$(PublishDir)%(ResolvedRuntimePack.FrameworkName)-NOTICES.txt"
          Condition="Exists('%(ResolvedRuntimePack.PackageDirectory)\THIRD-PARTY-NOTICES.TXT')" />
    <Copy SourceFiles="%(ResolvedRuntimePack.PackageDirectory)\LICENSE.TXT"
          DestinationFiles="$(PublishDir)%(ResolvedRuntimePack.FrameworkName)-LICENSE.txt"
          Condition="Exists('%(ResolvedRuntimePack.PackageDirectory)\LICENSE.TXT')" />
    <Copy SourceFiles="%(ResolvedRuntimePack.PackageDirectory)\LICENSE"
          DestinationFiles="$(PublishDir)%(ResolvedRuntimePack.FrameworkName)-LICENSE.txt"
          Condition="Exists('%(ResolvedRuntimePack.PackageDirectory)\LICENSE')" />
  </Target>
</Project>
